# Keep the build context small & reproducible.
.git
.gitignore
.venv
venv
__pycache__
*.pyc
.pytest_cache
out
web/node_modules
web/dist
web/.vite
.DS_Store
*.md
.claude
# NOTE: Book1.csv is intentionally NOT ignored — it is baked in at build time
# via --build-arg INPUT_CSV=Book1.csv. Remove it from context if you prefer to
# mount data at runtime instead (see deploy/DEPLOY.md).
